   <?xml version="1.0" ?>                                                                                                                                                     
    <sdf version="1.8">                                                                                                                                                        
      <world name="erc_world">                                                                                                                                                 
        <!-- Physics engine settings -->                                                                                                                                       
        <physics name="1ms" type="ignored">                                                                                                                                    
          <max_step_size>0.002</max_step_size>                                                                                                                                 
          <real_time_factor>1.0</real_time_factor>                                                                                                                             
        </physics>                                                                                                                                                             
                                                                                                                                                                               
        <!-- Essential Gazebo Plugins for Sensors and Physics -->                                                                                                              
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />                                                                                           
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />                                                                                
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />                                                                        
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">                                                                                             
          <render_engine>ogre2</render_engine>                                                                                                                                 
        </plugin>                                                                                                                                                              
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />                                                                                                   
        <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />                                                                                             
                                                                                                                                                                               
        <!-- Outdoor Lighting -->                                                                                                                                              
        <light type="directional" name="sun">                                                                                                                                  
          <cast_shadows>true</cast_shadows>                                                                                                                                    
          <pose>0 0 20 0 0 0</pose>                                                                                                                                            
          <diffuse>0.9 0.9 0.85 1</diffuse>                                                                                                                                    
          <specular>0.2 0.2 0.2 1</specular>                                                                                                                                   
          <direction>-0.5 0.1 -0.9</direction>                                                                                                                                 
        </light>                                                                                                                                                               
                                                                                                                                                                               
        <!-- Ground Plane (Terrain) -->                                                                                                                                        
        <model name="ground_plane">                                                                                                                                            
          <static>true</static>                                                                                                                                                
          <link name="link">                                                                                                                                                   
            <collision name="collision">                                                                                                                                       
              <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>                                                                                   
              <surface>                                                                                                                                                        
                <friction>                                                                                                                                                     
                  <ode><mu>1.0</mu><mu2>1.0</mu2></ode>                                                                                                                        
                </friction>                                                                                                                                                    
              </surface>                                                                                                                                                       
            </collision>                                                                                                                                                       
            <visual name="visual">                                                                                                                                             
              <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>                                                                                   
              <material>                                                                                                                                                       
                <ambient>0.8 0.6 0.4 1</ambient>                                                                                                                               
                <diffuse>0.8 0.6 0.4 1</diffuse>                                                                                                                               
              </material>                                                                                                                                                      
            </visual>                                                                                                                                                          
          </link>                                                                                                                                                              
        </model>                                                                                                                                                               
                                                                                                                                                                               
        <!-- Reference GPS Origin (ERC Competition Site in Poland) -->                                                                                                         
        <spherical_coordinates>                                                                                                                                                
          <surface_model>EARTH_WGS84</surface_model>                                                                                                                           
          <latitude_deg>50.0614</latitude_deg>                                                                                                                                 
          <longitude_deg>19.9365</longitude_deg>                                                                                                                               
          <elevation>220.0</elevation>                                                                                                                                         
          <heading_deg>0.0</heading_deg>                                                                                                                                       
        </spherical_coordinates>                                                                                                                                               
                                                                                                                                                                               
        <!-- Some ERC Obstacles / Boulders -->                                                                                                                                 
        <model name="rock_1">                                                                                                                                                  
          <static>true</static>                                                                                                                                                
          <pose>3.0 1.5 0.3 0 0 0</pose>                                                                                                                                       
          <link name="link">                                                                                                                                                   
            <collision name="col"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry></collision>                                               
            <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>                                                              
              <material><ambient>0.4 0.3 0.3 1</ambient><diffuse>0.5 0.4 0.4 1</diffuse></material>                                                                            
            </visual>                                                                                                                                                          
          </link>                                                                                                                                                              
        </model>                                                                                                                                                               
                                                                                                                                                                               
        <model name="rock_2">                                                                                                                                                  
          <static>true</static>                                                                                                                                                
          <pose>6.0 -2.0 0.4 0 0 0</pose>                                                                                                                                      
          <link name="link">                                                                                                                                                   
            <collision name="col"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>                                                                         
            <visual name="vis"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>                                                                                        
              <material><ambient>0.4 0.3 0.3 1</ambient><diffuse>0.5 0.4 0.4 1</diffuse></material>                                                                            
            </visual>                                                                                                                                                          
          </link>                                                                                                                                                              
        </model>                                                                                                                                                               
      </world>                                                                                                                                                                 
    </sdf> 